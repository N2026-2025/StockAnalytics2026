# Configuración de la API Risk Analytics & Multi-Asset Argentina

# Proyecto
PROJECT_NAME=Risk Analytics & Multi-Asset Argentina API
VERSION=1.0.0
API_V1_STR=/api/v1

# Activos por defecto (multi-asset) - separados por coma
DEFAULT_TICKERS=ZS=F,BZ=F,YPF

# Activos cripto - separados por coma
DEFAULT_CRYPTO_TICKERS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,BNB-USD

# Rango de fechas para descarga de datos
DEFAULT_START=2020-01-01
DEFAULT_END=

# Motor cuantitativo
MONTE_CARLO_SCENARIOS=10000
RANDOM_SEED=42
VAR_CONFIDENCE=0.95

# Caché
CACHE_DIR=data/cache
CACHE_ENABLED=true